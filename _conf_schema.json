{
  "platforms": {
    "description": "解析平台",
    "hint": "关闭不需要的平台可以减少路由匹配与初始化开销。原生解析器优先，部分平台由 yt-dlp 兼容层处理。",
    "type": "object",
    "items": {
      "bilibili": {"description": "Bilibili / B站", "type": "bool", "default": true},
      "douyin": {"description": "抖音", "type": "bool", "default": true},
      "kuaishou": {"description": "快手", "type": "bool", "default": true},
      "weibo": {"description": "微博", "type": "bool", "default": true},
      "xiaohongshu": {"description": "小红书", "type": "bool", "default": true},
      "miyoushe": {"description": "米游社", "type": "bool", "default": true},
      "xiaoheihe": {"description": "小黑盒", "type": "bool", "default": true},
      "acfun": {"description": "AcFun（yt-dlp）", "type": "bool", "default": true},
      "netease_music": {"description": "网易云音乐（yt-dlp）", "type": "bool", "default": true}
    }
  },
  "comments": {
    "description": "热门评论",
    "hint": "热门评论仅用于视频作品，使用独立评论区图片并放入合并转发；失败或超时不影响主内容和媒体。",
    "type": "object",
    "items": {
      "bilibili": {"description": "B站视频评论区", "type": "bool", "default": true},
      "douyin": {
        "description": "抖音视频评论区",
        "hint": "仅视频作品启用；需要在“平台登录态”中配置抖音 Cookie，未配置时自动跳过。",
        "type": "bool",
        "default": true
      },
      "weibo": {"description": "微博视频评论区", "type": "bool", "default": true},
      "xiaohongshu": {
        "description": "小红书视频评论区",
        "hint": "仅视频笔记启用；需要在“平台登录态”中配置完整小红书 Cookie，图文笔记不会抓取评论。",
        "type": "bool",
        "default": false
      },
      "xiaoheihe": {"description": "小黑盒视频评论区", "type": "bool", "default": true},
      "miyoushe": {"description": "米游社视频评论区", "type": "bool", "default": true},
      "display_count": {
        "description": "热门评论数量",
        "hint": "按平台热门顺序最多展示多少条主评论，楼中楼首条回复不计入此数量。",
        "type": "int",
        "slider": {"min": 1, "max": 20, "step": 1},
        "default": 10
      },
      "timeout": {
        "description": "评论任务超时（秒）",
        "hint": "包含评论抓取、头像处理、独立评论图渲染和缓存写入；失败或超时不影响主内容和媒体发送。",
        "type": "int",
        "slider": {"min": 15, "max": 180, "step": 5},
        "default": 90
      }
    }
  },
  "rendering": {
    "description": "评论区渲染",
    "hint": "独立评论区图片复用 AstrBot 官方 html_render（Canvas/T2I），插件不会启动本地 Chromium。",
    "obvious_hint": true,
    "type": "object",
    "items": {
      "timeout": {
        "description": "单次渲染超时（秒）",
        "hint": "传递给 AstrBot html_render 的截图超时。网络 T2I 较慢时可适当调高。",
        "type": "int",
        "slider": {"min": 10, "max": 180, "step": 5},
        "default": 45
      }
    }
  },
  "performance": {
    "description": "下载与媒体",
    "hint": "这些选项影响下载并发、文件大小限制和 B站取流偏好。",
    "type": "object",
    "items": {
      "max_concurrent_downloads": {
        "description": "最大并发下载数",
        "type": "int",
        "slider": {"min": 1, "max": 12, "step": 1},
        "default": 4
      },
      "source_max_size": {
        "description": "单个资源上限（MB）",
        "hint": "超过此大小的媒体不会继续下载或发送。",
        "type": "int",
        "slider": {"min": 10, "max": 500, "step": 10},
        "default": 90
      },
      "video_codec": {
        "description": "B站视频编码偏好",
        "hint": "HEVC 体积通常更小；若协议端或客户端兼容性不好请选择 AVC。",
        "type": "string",
        "options": ["auto", "hevc", "avc"],
        "labels": ["自动选择", "优先 HEVC / H.265", "优先 AVC / H.264"],
        "default": "hevc"
      }
    }
  },
  "cookies": {
    "description": "平台登录态",
    "hint": "Cookie 仅写入本插件配置。建议使用专用小号，并在失效后及时更新。",
    "obvious_hint": true,
    "type": "object",
    "items": {
      "douyin_ck": {
        "description": "抖音 Cookie",
        "hint": "用于抖音解析和视频评论区。请粘贴完整 Cookie 字符串。",
        "type": "text",
        "default": ""
      },
      "bili_ck": {
        "description": "Bilibili Cookie",
        "hint": "用于提升 B站接口稳定性、动态解析与可用清晰度。",
        "type": "text",
        "default": ""
      },
      "weibo_cookie": {
        "description": "微博 Cookie",
        "hint": "可选；公开微博和热门评论通常无需登录，受限内容可使用该登录态。",
        "type": "text",
        "default": ""
      },
      "xiaohongshu_cookie": {
        "description": "小红书 Cookie",
        "hint": "仅用于小红书视频笔记评论区，请粘贴网页端完整 Cookie（必须包含 a1，通常还需要 web_session）。建议使用专用小号。",
        "type": "text",
        "default": ""
      },
      "xiaoheihe_cookie": {
        "description": "小黑盒 Cookie",
        "hint": "可选；公开帖子和游戏会先请求签名接口，受限内容或触发验证码时可配置登录态。",
        "type": "text",
        "default": ""
      },
      "ytdlp_cookie_file": {
        "description": "yt-dlp Cookie 文件",
        "hint": "上传 Netscape 格式的 cookies.txt，用于需要登录的 yt-dlp 兼容平台。",
        "type": "file",
        "file_types": ["txt"],
        "default": []
      }
    }
  },
  "debug": {
    "description": "Canvas 调试台",
    "hint": "用于在 AstrBot 插件 Page 中直接测试真实解析与消息投递结构。",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用独占调试模式",
        "hint": "默认关闭。开启后仅接受 Parser X 的 Canvas 插件调试页请求，QQ 与其他消息适配器中的分享链接将不再触发解析。",
        "type": "bool",
        "default": false
      }
    }
  },
  "behavior": {
    "description": "发送行为",
    "type": "object",
    "items": {
      "show_download_fail_tip": {
        "description": "显示下载失败提示",
        "hint": "关闭后，下载失败或超限时只写日志，不在聊天中提示。",
        "type": "bool",
        "default": true
      },
      "disabled_sessions": {
        "description": "已关闭解析的会话",
        "hint": "通常无需手动编辑；可在对应会话中使用 /开启解析、/关闭解析 管理。",
        "type": "list",
        "default": [],
        "collapsed": true
      }
    }
  },
  "bili_comment": {"description": "旧版 B站评论开关", "type": "bool", "default": true, "invisible": true},
  "comment_settings_migrated": {"description": "评论配置迁移标记", "type": "bool", "default": false, "invisible": true},
  "show_download_fail_tip": {"description": "旧版下载失败提示", "type": "bool", "default": true, "invisible": true},
  "disabled_sessions": {"description": "旧版关闭解析会话", "type": "list", "default": [], "invisible": true},
  "config_v2_migrated": {"description": "配置面板 v2 迁移标记", "type": "bool", "default": false, "invisible": true},
  "data_dir": {"description": "数据目录", "type": "string", "invisible": true},
  "cache_dir": {"description": "缓存目录", "type": "string", "invisible": true}
}
