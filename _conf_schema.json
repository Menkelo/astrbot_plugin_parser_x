{
  "disabled_sessions": {
    "description": "关闭解析的会话",
    "hint": "可在会话中使用 /开启解析、/关闭解析 管理",
    "type": "list",
    "default": []
  },
  "platforms": {
    "description": "平台开关",
    "hint": "原生解析器优先；通用平台由 yt-dlp 兼容层处理",
    "type": "object",
    "items": {
      "bilibili": {"description": "Bilibili（原生）", "type": "bool", "default": true},
      "douyin": {"description": "抖音（原生）", "type": "bool", "default": true},
      "kuaishou": {"description": "快手（原生）", "type": "bool", "default": true},
      "weibo": {"description": "微博（原生）", "type": "bool", "default": true},
      "xiaohongshu": {"description": "小红书（原生）", "type": "bool", "default": true},
      "miyoushe": {"description": "米游社（原生）", "type": "bool", "default": true},
      "tieba": {"description": "贴吧（原生）", "type": "bool", "default": true},
      "xiaoheihe": {"description": "小黑盒（原生）", "type": "bool", "default": true},
      "weixin_channel": {"description": "微信视频号（元宝接口）", "type": "bool", "default": false},
      "qq_music": {"description": "QQ音乐（原生元数据）", "type": "bool", "default": true},
      "kugou_music": {"description": "酷狗音乐（原生）", "type": "bool", "default": true},
      "acfun": {"description": "AcFun（yt-dlp）", "type": "bool", "default": true},
      "xigua": {"description": "西瓜视频（yt-dlp）", "type": "bool", "default": true},
      "pipixia": {"description": "皮皮虾（yt-dlp）", "type": "bool", "default": true},
      "weishi": {"description": "微视（yt-dlp）", "type": "bool", "default": true},
      "netease_music": {"description": "网易云音乐（yt-dlp）", "type": "bool", "default": true},
      "qishui_music": {"description": "汽水音乐（yt-dlp）", "type": "bool", "default": true}
    }
  },
  "bili_comment": {
    "description": "B站评论区",
    "hint": "解析 B站视频时额外生成评论区截图卡片",
    "type": "bool",
    "default": true
  },
  "show_download_fail_tip": {
    "description": "显示下载失败提示",
    "type": "bool",
    "default": true
  },
  "web_summary": {
    "description": "网页链接总结",
    "hint": "使用 /链接总结 <URL> 调用当前会话的 AstrBot 文本模型",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用链接总结命令",
        "type": "bool",
        "default": true
      },
      "max_page_kb": {
        "description": "网页最大读取大小（KB）",
        "type": "int",
        "slider": {"min": 128, "max": 4096, "step": 128},
        "default": 2048
      },
      "max_chars": {
        "description": "提交给模型的最大正文字符数",
        "type": "int",
        "slider": {"min": 2000, "max": 30000, "step": 1000},
        "default": 12000
      }
    }
  },
  "performance": {
    "description": "性能配置",
    "type": "object",
    "items": {
      "max_concurrent_downloads": {
        "description": "最大并发下载数",
        "type": "int",
        "slider": {"min": 1, "max": 12, "step": 1},
        "default": 4
      },
      "source_max_size": {
        "description": "资源最大大小（MB）",
        "type": "int",
        "slider": {"min": 10, "max": 500, "step": 10},
        "default": 90
      },
      "video_codec": {
        "description": "B站视频编码偏好",
        "type": "string",
        "options": ["auto", "hevc", "avc"],
        "default": "hevc"
      }
    }
  },
  "cookies": {
    "description": "Cookie 配置",
    "type": "object",
    "items": {
      "douyin_ck": {
        "description": "抖音 Cookie",
        "hint": "用于提升抖音解析稳定性",
        "type": "text",
        "default": ""
      },
      "bili_ck": {
        "description": "Bilibili Cookie",
        "hint": "用于提升 B站接口稳定性与清晰度",
        "type": "text",
        "default": ""
      },
      "qq_music_cookie": {
        "description": "QQ音乐 Cookie",
        "hint": "可选，用于提升 QQ音乐官方接口的可用性；不会绕过歌曲版权限制",
        "type": "text",
        "default": ""
      },
      "kugou_cookie": {
        "description": "酷狗音乐 Cookie",
        "hint": "可选，仅在配置自建酷狗 API 时用于按账号权限取流",
        "type": "text",
        "default": ""
      },
      "xiaoheihe_cookie": {
        "description": "小黑盒 Cookie",
        "hint": "可选。未配置时仅尝试读取公开页面元数据",
        "type": "text",
        "default": ""
      },
      "yuanbao_cookie": {
        "description": "腾讯元宝 Web Cookie",
        "hint": "微信视频号解析必需。建议使用专用账号并注意 Cookie 安全",
        "type": "text",
        "default": ""
      },
      "ytdlp_cookie_file": {
        "description": "yt-dlp Netscape Cookie 文件",
        "hint": "可选。用于国内 yt-dlp 兼容平台需要登录的情况",
        "type": "file",
        "file_types": ["txt"],
        "default": []
      }
    }
  },
  "integrations": {
    "description": "可选外部服务",
    "type": "object",
    "items": {
      "kugou_api_server": {
        "description": "自建酷狗 API 地址",
        "hint": "兼容 KuGouMusicApi 的服务地址；留空时只解析官方元数据",
        "type": "string",
        "default": ""
      },
      "kugou_audio_quality": {
        "description": "酷狗音质",
        "type": "string",
        "options": ["128", "320", "flac", "viper_clear"],
        "default": "128"
      },
      "tieba_api_base": {
        "description": "贴吧详情 API 地址",
        "hint": "可选，需兼容 /tieba/post_detail?tid=；留空时解析官方页面元数据",
        "type": "string",
        "default": ""
      }
    }
  },
  "data_dir": {"description": "数据目录", "type": "string", "invisible": true},
  "cache_dir": {"description": "缓存目录", "type": "string", "invisible": true}
}
